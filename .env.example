# ============================================================================
# LSMP AI Engine - Database Configuration for lsmp_ai.io
# ============================================================================
# WARNING: Default credentials (postgres:postgres) are strictly for local offline dev!
# In production, replace with a dedicated least-privilege user and strong password.

# Primary PostgreSQL / TimescaleDB Connection URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lsmp_db
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/lsmp_db

# Granular database credentials (used by DBClient as fallback if DATABASE_URL is omitted)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lsmp_db
POSTGRES_SSLMODE=disable

# ============================================================================
# API Security & Authentication Configuration (Fail-Closed)
# ============================================================================
# Secret API key required for /metadata and /process serving endpoints
LSMP_API_KEY=ChangeMeInProduction_LsmpApiKeySecret123!

# Set to 1 ONLY for local development or offline test runners without API keys
LSMP_ALLOW_INSECURE_DEV=0

# Rate Limiter & Reverse Proxy Settings
LSMP_RATE_LIMIT_MAX=30
LSMP_RATE_LIMIT_WINDOW=60
LSMP_RATE_LIMIT_MAX_IPS=10000
LSMP_TRUST_PROXY_HEADERS=0

# Logging & Rotation Bounds
LSMP_LOG_MAX_BYTES=10485760
LSMP_LOG_BACKUP_COUNT=5

