# ============================================================================
# file: .env.example
# Description: Environment configuration template for Wazuh Agent container.
# ============================================================================

# ====== Central Wazuh Manager Connection ======
# IP address or domain name of the remote Wazuh Manager (Server A)
WAZUH_MANAGER_IP=127.0.0.1
WAZUH_MANAGER_PORT=1514

# ====== Agent Metadata & Group Registration ======
# Hostname/name to identify this agent in the Wazuh SIEM Dashboard
AGENT_NAME=sme-endpoint-01
AGENT_GROUP=default
