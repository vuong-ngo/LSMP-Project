# ============================================================================
# file: .env.example
# Description: Configuration template for LSMP Ingestion Client Agent.
# ============================================================================

# ====== Grafana Loki Server Configuration ======
LOKI_HOST=127.0.0.1
LOKI_PORT=3100
LOKI_USER=
LOKI_PASSWORD=

# ====== TLS / Security Configuration ======
ENABLE_TLS=On
TLS_VERIFY=On

# ====== Wazuh Manager Syslog Configuration ======
# IP address or domain of your remote Wazuh Manager (Server A)
WAZUH_HOST=127.0.0.1
WAZUH_PORT=514

# ====== Client Metadata & Differentiating Labels ======
# Hostname label to distinguish this client machine from others (e.g., 'web-prod-01')
CLIENT_HOSTNAME=client-01
ENV=production

