# Redis authentication password (must match the one on the Wazuh Server)
REDIS_PASSWORD=PASSWORD
INGEST_TOKEN=<TOKEN>

# Information database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lsmp_db
