# ============================================================================
# file: database_server/.env.example
# Description: Configuration template for Database & AI Server (Server B).
#              Rename this file to '.env' and fill in configurations.
# ============================================================================

# ====== Ingestion Security & Buffer Configuration ======
# Redis authentication password (must match the one on the Wazuh Server)
REDIS_PASSWORD=PASSWORD
INGEST_TOKEN=<TOKEN>

# ====== PostgreSQL Database Configuration ======
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lsmp_db

# ====== TLS / Security Configuration ======
USE_TLS=true
