# ============================================================================
# file: .env.example
# Description: Configuration template for Fluent-bit on Wazuh Server (Server A).
#              Rename this file to '.env' and fill in remote Ingest details.
# ============================================================================

# ====== Remote Database Server (Ingest Receiver) Configuration ======
# IP address or domain name of the remote Database Server (Server B)
INGEST_HOST=lsmp-ingest
INGEST_PORT=8080

# ====== Ingestion Authentication Token ======
# Shared token (must match INGEST_TOKEN on Database Server B)
INGEST_TOKEN=<TOKEN>

# ====== TLS / Security Configuration ======
ENABLE_TLS=On
TLS_VERIFY=On
