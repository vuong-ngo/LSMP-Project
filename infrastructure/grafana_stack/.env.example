NODE_EXPORTER_VERSION=v1.8.0
SEAWEEDFS_VERSION=latest

# ====== S3 Object Storage Credentials ======
AWS_ACCESS_KEY_ID=loki
AWS_SECRET_ACCESS_KEY=supersecret
