    {
      "id": 2,
      "type": "stat",
      "title": "🏆 Highest F1-Score hien tai",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF2D6C",
                "value": null
              },
              {
                "color": "#FF7A00",
                "value": 0.6
              },
              {
                "color": "#00E676",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT DISTINCT ON (model_config) model_config as metric, f1_score as \"F1\" FROM evaluation_metrics WHERE model_config IN (${model_config:sqlstring}) AND dataset_split IN (${dataset_split:sqlstring}) ORDER BY model_config, evaluated_at DESC, f1_score DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ]
    },
