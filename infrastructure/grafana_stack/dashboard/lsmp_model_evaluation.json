    "list": [
      {
        "name": "DS_POSTGRES",
        "type": "datasource",
        "query": "postgres",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "model_config",
        "type": "query",
        "label": "Model Config",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT model_config FROM evaluation_metrics ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "dataset_split",
        "type": "query",
        "label": "Dataset Split",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT dataset_split FROM evaluation_metrics ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
