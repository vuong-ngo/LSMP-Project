{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki Data Source receiving raw auth.log streams from Alloy/Fluent-bit",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "id": null,
  "uid": "lsmp-auth-logs-dedicated",
  "title": "🔐 LSMP · Host Authentication Logs (/var/log/auth.log)",
  "description": "Dedicated dashboard for monitoring raw host authentication logs (/var/log/auth.log) with Hostname, Environment, Agent Type, and Live Text Filtering.",
  "tags": ["lsmp", "security", "auth", "loki", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "style": "dark",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "label": "Loki Data Source",
        "current": {}
      },
      {
        "name": "hostname",
        "type": "query",
        "label": "Host Name",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(hostname)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "label": "Environment",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "agent_type",
        "type": "query",
        "label": "Agent Type",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(agent_type)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Log Search Filter",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "<div style=\"background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%); padding: 14px 20px; border-radius: 8px; color: #fff;\">\n  <h2 style=\"margin: 0;\">🔐 HOST AUTHENTICATION LOG MONITOR (/var/log/auth.log)</h2>\n  <p style=\"margin: 4px 0 0 0; opacity: 0.9;\">Centralized Security Log Console for SSH, Sudo, and System Authentication Events</p>\n</div>"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "📜 Total Auth Log Lines",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 3 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#5794F2", "value": null }]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)sshd|auth|password|session\" [$__range]))",
          "legendFormat": "Total Auth Logs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "🔴 Failed Login Attempts",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 3 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#F2495C", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)failed password|invalid user|authentication failure\" [$__range]))",
          "legendFormat": "Failed Logins",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "🟢 Successful Logins",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 3 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#73BF69", "value": null }]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)accepted password|session opened\" [$__range]))",
          "legendFormat": "Accepted Logins",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "📈 Authentication Failure vs Success Rate Trend",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "lineInterpolation": "smooth" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)failed password|invalid user\" [1m]))",
          "legendFormat": "🔴 Failed Login Rate (logs/s)",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)accepted password\" [1m]))",
          "legendFormat": "🟢 Accepted Login Rate (logs/s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "📜 Real-time RAW Auth Log Viewer Console (/var/log/auth.log)",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{job=~\".*\", hostname=~\"$hostname\", env=~\"$environment\"} |~ \"(?i)$search\"",
          "refId": "A"
        }
      ]
    }
  ],
  "liveNow": true
}
