        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT src_ip, max(score) AS max_score, count(*) AS events, max(risk_class) AS worst_class, max(\"timestamp\") AS last_seen FROM risk_score WHERE $__timeFilter(\"timestamp\") AND src_ip IN (${src_ip:sqlstring}) GROUP BY src_ip ORDER BY max_score DESC LIMIT 15",
          "format": "table",
          "refId": "A"
        }
      ]
