          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT $__timeGroup(\"timestamp\", '1m') AS time, avg(score) AS \"Avg Risk Score\", max(score) AS \"Max Risk Score\" FROM risk_score WHERE $__timeFilter(\"timestamp\") AND src_ip IN (${src_ip:sqlstring}) GROUP BY 1 ORDER BY 1",
