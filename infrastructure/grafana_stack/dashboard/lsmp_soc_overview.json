  "id": null,
  "uid": "lsmp-soc-overview",
  "title": "LSMP · SOC Security Overview (Real-time Risk Monitoring)",
  "description": "Centralized SOC Monitoring Dashboard: Aggregated Risk Score from AI Cascade + Wazuh Rules, Anomaly Detection, Log Traffic, and Attack Scenarios.",
  "tags": [
    "lsmp",
    "security",
    "soc",
    "risk"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "style": "dark",
  "editable": true,
  "graphTooltip": 2,
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "type": "datasource",
        "query": "postgres",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "src_ip",
        "type": "query",
        "label": "Source IP",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT src_ip FROM risk_score ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "model_version",
        "type": "query",
        "label": "Model Version",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT model_version FROM anomaly_result ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Attack scenarios",
        "datasource": {
          "type": "postgres",
          "uid": "${DS_POSTGRES}"
        },
        "enable": true,
        "iconColor": "rgba(255, 45, 108, 1)",
        "rawQuery": true,
        "query": "SELECT start_time as time, end_time as timeend, scenario_name as text, attack_type as tags FROM attack_scenarios WHERE $__timeFilter(start_time)"
      }
    ]
  },
