      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "rawSql": "SELECT \"timestamp\" as time, count(*) OVER (ORDER BY \"timestamp\") as \"Critical\" FROM risk_score WHERE risk_class = 'Critical' AND $__timeFilter(\"timestamp\") AND src_ip IN (${src_ip:sqlstring})",
          "format": "time_series",
          "refId": "A"
