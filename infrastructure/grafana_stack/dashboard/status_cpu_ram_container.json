{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus Data Source receiving metrics from Alloy & Node Exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki Data Source receiving container logs from Alloy",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "id": null,
  "uid": "alloy-lsmp-telemetry-synced",
  "title": "⚡ LSMP · Alloy Unified Telemetry (Synced)",
  "description": "Centralized telemetry dashboard for hardware resource monitoring (Prometheus Node Exporter) and Docker Container Logs (Loki).",
  "tags": ["lsmp", "alloy", "prometheus", "loki", "hardware"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "style": "dark",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus DS",
        "current": {}
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "label": "Loki DS",
        "current": {}
      },
      {
        "name": "container",
        "type": "query",
        "label": "Container Filter",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(container)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "<div style=\"background: linear-gradient(135deg, #1f1c2c 0%, #928dab 100%); padding: 12px 20px; border-radius: 8px; color: #fff;\">\n  <h2 style=\"margin: 0;\">🚀 ALLOY UNIFIED OBSERVABILITY DASHBOARD</h2>\n  <p style=\"margin: 4px 0 0 0; opacity: 0.9;\">Centralized Host Hardware Metrics & Docker Container Log Console</p>\n</div>"
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "💻 1. SYSTEM HARDWARE METRICS (PROMETHEUS / ALLOY NODE EXPORTER)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "🔥 Host CPU Usage",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#FF780A", "value": 70 },
              { "color": "#F2495C", "value": 85 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU Usage %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "🧠 Host RAM Usage",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#5794F2", "value": null },
              { "color": "#FF780A", "value": 75 },
              { "color": "#F2495C", "value": 90 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM Usage %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "💾 Used RAM / Total Capacity",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#B14EFF", "value": null }]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used RAM",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "🌐 Network I/O (Receive Rate)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#00D9FF", "value": null }]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "Network In",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "📈 CPU Load & Memory Utilization Trend",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU Usage %",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM Usage %",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "📋 2. DOCKER CONTAINER LOG DETAILS (LOKI DOCKER SOURCE)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Container Log Status & Log Generation Rate Statistics",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "showHeader": true },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true, "align": "center" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "container" },
            "properties": [{ "id": "displayName", "value": "Container Name" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [{ "id": "displayName", "value": "Total Log Lines" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Log Rate (Logs/s)" },
              { "id": "unit", "value": "reqps" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Error Alerts" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "rgba(50, 172, 45, 0.2)", "value": null },
                    { "color": "rgba(245, 54, 54, 0.8)", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({container=~\"$container\"}[$__range]))",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (container) (rate({container=~\"$container\"}[1m]))",
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} |~ \"(?i)error|exception|fail\" [$__range]))",
          "instant": true,
          "format": "table",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "📜 Real-time Container Log Viewer Console",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{container=~\"$container\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "liveNow": true
}
